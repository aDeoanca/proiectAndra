# ----------------------------------------------------------------------------
# Apache Maven Wrapper startup script, version 3.3.2
# ----------------------------------------------------------------------------

# If JAVA_HOME is not set, attempt to detect it
if [ -z "$JAVA_HOME" ]; then
  JAVA_EXECUTABLE=java
else
  JAVA_EXECUTABLE="$JAVA_HOME/bin/java"
fi

# Determine the script directory
MAVEN_PROJECTBASEDIR="${MAVEN_BASEDIR:-$(pwd)}"
SCRIPT_DIR=$(dirname "$0")
cd "$SCRIPT_DIR" || exit 1
MAVEN_PROJECTBASEDIR=$(pwd)

MAVEN_WRAPPER_PROPERTIES="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.properties"
MAVEN_WRAPPER_JAR="$MAVEN_PROJECTBASEDIR/.mvn/wrapper/maven-wrapper.jar"

if [ -f "$MAVEN_WRAPPER_PROPERTIES" ]; then
  DISTRIBUTION_URL=$(grep distributionUrl "$MAVEN_WRAPPER_PROPERTIES" | cut -d= -f2-)
fi

# Download maven-wrapper.jar if not present
if [ ! -f "$MAVEN_WRAPPER_JAR" ]; then
  WRAPPER_URL=$(grep wrapperUrl "$MAVEN_WRAPPER_PROPERTIES" 2>/dev/null | cut -d= -f2-)
  if [ -n "$WRAPPER_URL" ]; then
    if command -v curl > /dev/null 2>&1; then
      curl -fsSL -o "$MAVEN_WRAPPER_JAR" "$WRAPPER_URL"
    elif command -v wget > /dev/null 2>&1; then
      wget -q -O "$MAVEN_WRAPPER_JAR" "$WRAPPER_URL"
    fi
  fi
fi

exec "$JAVA_EXECUTABLE" \
  -classpath "$MAVEN_WRAPPER_JAR" \
  "-Dmaven.multiModuleProjectDirectory=$MAVEN_PROJECTBASEDIR" \
  org.apache.maven.wrapper.MavenWrapperMain "$@"
